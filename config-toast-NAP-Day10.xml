    <Text Option="MultiLanguageSupport" Enabled="False" />
    <Text>
        <Greeting>SYSTEM ADMINISTRATOR</Greeting>
        <Greeting>SYSTEM ADMINISTRATOR</Greeting>  
        <Greeting>SYSTEM ADMINISTRATOR</Greeting>
